# Copia este archivo a .env y completa los valores. En el hosting, define estas
# mismas variables en su panel (no subas .env al repositorio).
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/caberti
# true si tu PostgreSQL del hosting exige SSL (Render, Railway, Supabase, Neon...)
DATABASE_SSL=false
# Número de WhatsApp de Caberti con lada del país y sin signos. Ejemplo (México): 529621234567
WHATSAPP_NUMBER=
# Días que dura la sesión iniciada
SESSION_DAYS=7
# Proxies delante de la app (1 en la mayoría de hosting). Por defecto: 1 en producción, 0 en local.
# TRUST_PROXY=1
